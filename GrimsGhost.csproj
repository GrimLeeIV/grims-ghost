<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GrimsGhost</AssemblyName>
    <RootNamespace>GrimsGhost</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Product>Grim's Ghost</Product>
    <AssemblyTitle>Grim's Ghost</AssemblyTitle>
    <Version>1.69.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <EmbeddedResource Include="src\editor.html" LogicalName="GrimsGhost.editor.html" />
    <EmbeddedResource Include="src\player.html" LogicalName="GrimsGhost.player.html" />
  </ItemGroup>

  <!-- Optional runtime dependency: ffmpeg (video + instant replay). Copied next to the exe for local runs if present in deps\. -->
  <ItemGroup>
    <None Include="deps\ffmpeg.exe" Link="ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('deps\ffmpeg.exe')" />
    <None Include="deps\ffmpeg-LICENSE.txt" Link="ffmpeg-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('deps\ffmpeg-LICENSE.txt')" />
  </ItemGroup>

  <!-- The installer lives in setup\ and is built separately -->
  <ItemGroup>
    <Compile Remove="setup\**" />
    <None Remove="setup\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- Build-time API definitions for Windows' built-in, offline OCR (Windows.Media.Ocr). Nothing extra ships. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
  </ItemGroup>

</Project>
